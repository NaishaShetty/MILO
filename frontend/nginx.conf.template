# nginx.conf.template
#
# Purpose
# -------
# Serves the Vite production build as a single-page app and reverse-
# proxies `/api` and `/health` to the backend -- the production
# equivalent of vite.config.ts's dev-server proxy, so the frontend's
# API client (relative URLs only, see src/api/client.ts) never needs
# to know the backend's address at build time. ${BACKEND_ORIGIN} is
# substituted at container start (see Dockerfile).
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # The canonical MILO character assets (frontend/public/assets/milo/,
    # copied verbatim into the build -- see src/state/miloState.ts) and
    # every other hashed build asset: served directly, long-cached.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Docker's embedded DNS (127.0.0.11 on any user-defined bridge
    # network, e.g. docker-compose's default network) -- resolving
    # ${BACKEND_ORIGIN} into a `set` variable (below) instead of using
    # it directly in `proxy_pass` defers DNS lookup to request time.
    # Without this, nginx resolves proxy_pass hostnames once at config
    # load and refuses to start at all if that name isn't resolvable
    # yet (e.g. the frontend container starting before/without the
    # backend one) -- a real startup-ordering trap, not a theoretical
    # one. This way the frontend always starts; requests just 502 until
    # the backend is reachable.
    resolver 127.0.0.11 valid=30s;

    location /api/ {
        set $backend_upstream ${BACKEND_ORIGIN};
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health {
        set $backend_upstream ${BACKEND_ORIGIN};
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
    }

    # SPA fallback -- react-router owns client-side routing for every
    # other path (the seven MILO pages), so unknown paths still resolve
    # to index.html rather than a raw nginx 404.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
