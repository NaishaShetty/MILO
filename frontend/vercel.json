{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://REPLACE_WITH_MILO_BACKEND_HOST/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://REPLACE_WITH_MILO_BACKEND_HOST/health"
    },
    {
      "source": "/((?!api/|health).*)",
      "destination": "/index.html"
    }
  ]
}
