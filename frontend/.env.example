# frontend/.env.example
#
# Local development only. Copy to frontend/.env(.local) if you need to
# override it -- see vite.config.ts's "Why a dev-server proxy for /api"
# docstring. Nothing here is read by the production build: the built
# bundle never reads import.meta.env for the backend address (only
# relative URLs, see src/api/client.ts) and this file has no effect on
# a Vercel deployment (see vercel.json / README.md's "Deployment"
# section instead).

# Where Vite's dev server proxies /api and /health to. Defaults to
# http://localhost:8000 if unset.
# VITE_BACKEND_URL=http://localhost:8000
