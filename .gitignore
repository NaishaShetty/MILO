# ----------------------------
# Python
# ----------------------------
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ----------------------------
# Locally downloaded wheels (e.g. backend/scripts/download_torch.py's
# output) -- large binaries, reproducible via that script, never
# committed.
# ----------------------------
*.whl

# ----------------------------
# Generated perception outputs
#
# NOTE: these are rooted at backend/outputs/, not a top-level
# outputs/ -- patterns must say so explicitly. A bare "outputs/*.png"
# only matches a top-level outputs/ dir per gitignore's anchoring
# rules (any pattern containing a non-trailing slash is rooted at the
# .gitignore's own directory), so it silently never matched anything
# here. Fixed as part of the Phase 8.1 audit.
# ----------------------------
backend/outputs/*.png
backend/outputs/*.jpg
backend/outputs/*.jpeg
!backend/outputs/.gitkeep

# ----------------------------
# Generated runtime databases (memory store + vector store --
# regenerate on first use from MEMORY_DATABASE_PATH /
# MEMORY_VECTOR_STORE_PATH, see backend/.env.example)
# ----------------------------
backend/outputs/**/*.db

# ----------------------------
# Editor / OS
# ----------------------------
.DS_Store
.idea/
.vscode/

# ----------------------------
# Local Claude Code tooling state (permission allowlist, task locks) --
# machine-local, not project source; removed from tracking in the
# Phase 8.7 authorship/attribution cleanup.
# ----------------------------
.claude/

# ----------------------------
# Local design references (Phase 8.2 visual mockups) -- reference-only,
# never part of the shipped product; removed from tracking in Phase 8.1
# and must not be reintroduced (see Phase 8.7 audit).
# ----------------------------
MOCKUPS/

# ----------------------------
# Stray root-level Playwright run marker (the real E2E config runs from
# frontend/, see frontend/test-results/ above; this is generated if
# `playwright test` is ever invoked from the repo root by mistake).
# ----------------------------
/test-results/

# ----------------------------
# Secrets / environment
# ----------------------------
.env

# ----------------------------
# Model weights (large, reproducible via ModelManager)
# ----------------------------
models/*
!models/.gitkeep

# ----------------------------
# Benchmark/experiment run outputs
# ----------------------------
results/*
!results/.gitkeep
!results/README.md

# experiments/results/ holds raw benchmark run output (timestamped
# json/csv), same nature as results/ above -- ignored by default so
# future runs don't accumulate as tracked files. The
# benchmark_20260809T120511Z run is a deliberate exception: it's the
# cited reproducibility source for experiments/reports/phase6_4_report.md
# (see that report's opening section) and stays tracked.
experiments/results/*
!experiments/results/benchmark_20260809T120511Z.json
!experiments/results/benchmark_20260809T120511Z_episodes.csv

# ----------------------------
# Stray root-level node_modules/.vite cache -- created if a Node
# tool is ever invoked from the repo root by mistake; the real
# frontend dependency tree lives in frontend/node_modules/ below.
# ----------------------------
/node_modules/

# ----------------------------
# Frontend (Phase 3.7 -- frontend/, Vite + React + TypeScript)
# ----------------------------
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.env
frontend/.env.local

# Playwright E2E (frontend/tests/e2e/) -- generated reports/artifacts,
# never source. Chromium itself installs to ~/.cache/ms-playwright/
# (outside the repo entirely, via `npx playwright install`), so
# nothing browser-binary-related ever needs ignoring here.
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/
