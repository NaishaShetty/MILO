# backend/.env.example
#
# Copy this file to backend/.env and fill in your key. backend/.env is
# gitignored (see the repository root .gitignore's "Secrets /
# environment" section) -- it is loaded automatically by
# backend/api/app.py on startup (via python-dotenv), so you only need
# to set these once instead of re-exporting them in every shell.
#
# Never commit backend/.env, paste a real key into a commit/PR/issue,
# or bake one into a Docker image -- see backend/docs/
# language_interface_spec.md section 30.9 and language/config.py's
# Security note.
#
#   cp backend/.env.example backend/.env
#   # then edit backend/.env with a real editor

# Selects the LLM provider LanguageAgent.from_config() uses --
# "openai" (default), "gemini", or "qwen" (local/self-hosted). Uncomment
# exactly one block below (or leave all unset to use the OpenAI default
# with OPENAI_API_KEY).

# ---- OpenAI ----
# LANGUAGE_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ---- Gemini (free-tier friendly for development; see root README) ----
# LANGUAGE_LLM_PROVIDER=gemini
# GEMINI_API_KEY=...

# ---- Local Qwen (or any OpenAI-API-compatible local server, e.g.
# vLLM/Ollama; see root README's "Local Qwen / Local LLM" section) ----
# LANGUAGE_LLM_PROVIDER=qwen
# LANGUAGE_LLM_BASE_URL=http://localhost:8000/v1
# LANGUAGE_LLM_MODEL=qwen2.5-7b-instruct
# Many local servers do not check this value at all -- if yours
# doesn't, set any placeholder (never a real secret) so
# _resolve_api_key still finds a value.
# QWEN_API_KEY=not-needed

# Optional overrides -- every one of these already has a sensible
# per-provider default (see backend/language/config.py); uncomment
# only what you need to change.
# LANGUAGE_LLM_MODEL=
# LANGUAGE_LLM_BASE_URL=
# LANGUAGE_LLM_API_KEY_ENV_VAR=
# LANGUAGE_LLM_TIMEOUT_SECONDS=30
# LANGUAGE_LLM_MAX_RETRIES=2
# LANGUAGE_RUNTIME_MAX_RETRIES=2

# CORS allow-list for the Phase 3.7 API (comma-separated). Defaults to
# the Vite dev server's origin if unset -- see backend/api/app.py.
# API_ALLOWED_ORIGINS=http://localhost:5173

# ---- Vision (Phase 3.x) ----
# See docs/architecture/spatial_perception.md for the full picture.
#
# Off by default: constructing a real VisionSystem launches AI2-THOR/
# Unity, which can block far longer than an API startup should if no
# display is available (this project's CI, most containers). Only set
# this to true where a real simulator is actually reachable.
# VISION_ENABLE_SIMULATOR=false
#
# "ground_truth" (AI2-THOR, metric meters) or "depth_anything" (learned,
# relative -- see vision/depth/depth_anything_estimator.py).
# VISION_DEPTH_SOURCE=ground_truth
#
# Leave unset locally (WSLg/a real desktop auto-detects a display).
# Only set this on a real headless GPU server with no X server -- see
# simulator/ai2thor_env.py's "Headless GPU deployment" note.
# "cloud_rendering" (AI2-THOR's EGL-based headless platform, no X11
# needed) or "linux64" (a real X server is still required).
# VISION_SIMULATOR_PLATFORM=cloud_rendering
#
# Depth-extraction thresholds (vision/depth/depth_config.py).
# VISION_MIN_VALID_DEPTH_RATIO=0.5
# VISION_MAX_PLAUSIBLE_DEPTH_METERS=20.0
#
# Tracking thresholds (vision/tracking/tracker_config.py).
# VISION_TRACKER_IOU_THRESHOLD=0.3
# VISION_TRACKER_MAX_MISSED_FRAMES=5
# VISION_TRACKER_USE_3D_DISTANCE=true
# VISION_TRACKER_MAX_3D_DISTANCE_M=0.5

# ---- Memory (Phase 6.1) ----
# See docs/phases/phase6_memory.md for the full picture. Nothing in the
# rest of the application constructs a MemoryManager yet (Phase 6.1 is
# foundation only -- no planner/agent wiring); these settings only take
# effect once a caller does `MemoryManager.from_config(MemoryConfig.
# from_env())` (backend/memory/manager.py, config.py).
#
# Master enable/disable switch for a future caller to check before
# constructing a MemoryManager -- not read by MemoryManager itself.
# MEMORY_ENABLED=true
#
# SQLite database file for structured memory persistence. Defaults to
# backend/outputs/memory/memory.db (created on first use).
# MEMORY_DATABASE_PATH=
#
# Directory backend/memory/retrieval.py's build_retrieval_engine()
# creates vectors.db inside (backend/memory/sqlite_vector_store.py).
# Defaults to backend/outputs/memory/vector_store.
# MEMORY_VECTOR_STORE_PATH=

# ---- Memory Intelligence / Retrieval (Phase 6.2) ----
# See docs/phases/phase6_memory.md. Still no planner/agent wiring --
# these settings only take effect once a caller constructs a
# RetrievalEngine directly (backend/memory/retrieval.py) or via
# build_retrieval_engine().
#
# "hashing" is the only supported provider today -- a deterministic,
# offline, dependency-free embedder (backend/memory/embeddings.py).
# MEMORY_EMBEDDING_PROVIDER=hashing
# MEMORY_EMBEDDING_DIMENSION=512
# Reserved for a future model-backed embedding provider; unused by the
# hashing embedder.
# MEMORY_EMBEDDING_MODEL_NAME=
# MEMORY_EMBEDDING_DEVICE=cpu
#
# Ranking weights (RankingWeights.from_env(), backend/memory/
# retrieval.py) -- must not be negative; need not sum to 1 (the score
# is normalized by their sum). See that class's docstring for the
# rationale behind these defaults.
# MEMORY_RETRIEVAL_WEIGHT_SIMILARITY=0.45
# MEMORY_RETRIEVAL_WEIGHT_CONFIDENCE=0.20
# MEMORY_RETRIEVAL_WEIGHT_RECENCY=0.15
# MEMORY_RETRIEVAL_WEIGHT_PROVENANCE=0.10
# MEMORY_RETRIEVAL_WEIGHT_CONTEXT=0.10
# MEMORY_RETRIEVAL_RECENCY_HALF_LIFE_SECONDS=604800
# MEMORY_RETRIEVAL_SIMILARITY_THRESHOLD=0.0
# MEMORY_RETRIEVAL_CANDIDATE_POOL_MULTIPLIER=5
# MEMORY_RETRIEVAL_MIN_CANDIDATE_POOL=20

# ---- Speech / STT (Whisper, Phase 7.14 / 8.5) ----
# See backend/speech/config.py. Off by default -- loading a Whisper
# model is a heavyweight operation (downloads/loads a multi-hundred-MB
# model on first use) that should never happen implicitly just because
# the API process started.
# SPEECH_ENABLE_WHISPER=false
#
# "tiny", "base" (default), "small", "medium", or "large" -- the
# project's own speed/accuracy tradeoff default assumes a development
# machine without a dedicated GPU.
# WHISPER_MODEL_SIZE=base
#
# "cpu" (default) or "cuda" -- passed straight through to
# whisper.load_model().
# WHISPER_DEVICE=cpu
#
# Which STT backend the frontend's live mic pipeline calls (GET
# /api/v1/speech reports this) -- "whisper" (default, this section) or
# "elevenlabs" (the Voice section below, same account already used for
# TTS). Selecting a provider here does not itself enable it --
# SPEECH_ENABLE_WHISPER/VOICE_ENABLE_ELEVENLABS still independently
# gate whether each is actually usable.
# STT_PROVIDER=whisper

# ---- Voice (ElevenLabs, Phase 8.2) ----
# See backend/voice/config.py. Off by default -- same opt-in rationale
# as SPEECH_ENABLE_WHISPER above, plus ElevenLabs is a paid third-party
# API, so a deployment must opt in explicitly rather than start making
# billable calls just because a key happens to be set.
# VOICE_ENABLE_ELEVENLABS=false
#
# Never commit a real key here or anywhere else -- resolved from
# os.environ at call time only, exactly like OPENAI_API_KEY/
# GEMINI_API_KEY above (see language/config.py's Security note).
# ELEVENLABS_API_KEY=
#
# MILO's fixed ElevenLabs voice -- not a secret. Configurable, but
# this is the voice MILO is meant to use; do not substitute another.
# ELEVENLABS_VOICE_ID=ISnQja0Ank6t1FE2Wj07
#
# Optional overrides -- every one already has a sensible default (see
# voice/config.py); uncomment only what you need to change.
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# VOICE_TIMEOUT_SECONDS=30
# VOICE_MAX_RETRIES=2
